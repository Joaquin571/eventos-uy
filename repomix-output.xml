<file path="webapp/src/main/webapp/WEB-INF/views/usuario.jsp">
<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="raiz" value="${pageContext.request.contextPath}" />
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><c:out value="${perfil.nombre}" /> - eventos.uy</title>
    <link rel="stylesheet" href="${raiz}/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="${raiz}/css/styles.css">
</head>
<body class="bg-light">

<jsp:include page="/WEB-INF/views/fragmentos/cabezal.jsp" />

<main class="container py-5">
    <c:if test="${not empty exito}"><div class="alert alert-success" role="status"><c:out value="${exito}" /></div></c:if>
    <c:if test="${not empty advertencia}"><div class="alert alert-warning" role="alert"><c:out value="${advertencia}" /></div></c:if>
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <c:url var="urlImagen" value="/imagen">
                        <c:param name="tipo" value="usuario" />
                        <c:param name="id" value="${perfil.nickname}" />
                    </c:url>

                    <div class="d-flex justify-content-between align-items-start">
                        <div class="d-flex align-items-center">
                            <img src="${urlImagen}" alt="Imagen de perfil"
                                 class="rounded-circle me-3"
                                 style="width: 96px; height: 96px; object-fit: cover;">
                            <div>
                                <h1 class="h3 mb-1">
                                    <c:out value="${perfil.nombre}" />
                                    <c:if test="${esAsistente}"> <c:out value="${perfil.apellido}" /></c:if>
                                </h1>
                                <span class="badge bg-secondary">
                                    <c:choose>
                                        <c:when test="${esOrganizador}">Organizador</c:when>
                                        <c:otherwise>Asistente</c:otherwise>
                                    </c:choose>
                                </span>
                            </div>
                        </div>
                        <c:if test="${esPropio}">
                            <a href="${raiz}/modificar-usuario" class="btn btn-outline-primary">Editar perfil</a>
                        </c:if>
                    </div>

                    <hr>

                    <dl class="row mb-0">
                        <dt class="col-sm-4">Miembro desde</dt>
                        <dd class="col-sm-8"><c:out value="${fechaAlta}" /></dd>

                        <dt class="col-sm-4">Nickname</dt>
                        <dd class="col-sm-8"><c:out value="${perfil.nickname}" /></dd>

                        <dt class="col-sm-4">Correo electrónico</dt>
                        <dd class="col-sm-8"><c:out value="${perfil.correoElectronico}" /></dd>

                        <c:if test="${esAsistente}">
                            <dt class="col-sm-4">Fecha de nacimiento</dt>
                            <dd class="col-sm-8"><c:out value="${fechaNacimiento}" /></dd>

                            <dt class="col-sm-4">Institución</dt>
                            <dd class="col-sm-8">
                                <c:out value="${empty perfil.nombreInstitucion ? 'Ninguna' : perfil.nombreInstitucion}" />
                            </dd>
                        </c:if>

                        <c:if test="${esOrganizador}">
                            <dt class="col-sm-4">Descripción</dt>
                            <dd class="col-sm-8"><c:out value="${perfil.descripcion}" /></dd>

                            <c:if test="${not empty perfil.sitioWeb}">
                                <dt class="col-sm-4">Sitio web</dt>
                                <dd class="col-sm-8"><c:out value="${perfil.sitioWeb}" /></dd>
                            </c:if>
                        </c:if>
                    </dl>
                </div>
            </div>

            <c:if test="${esOrganizador}">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <h2 class="h5 mb-3">Ediciones</h2>

                        <c:if test="${empty ediciones}">
                            <p class="text-muted mb-0">No hay ediciones para mostrar.</p>
                        </c:if>

                        <div class="list-group">
                            <c:forEach var="edicion" items="${ediciones}">
                                <c:url var="urlEdicion" value="/edicion">
                                    <c:param name="nombre" value="${edicion.idNombre}" />
                                </c:url>
                                <a href="${urlEdicion}"
                                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                    <span>
                                        <strong><c:out value="${edicion.idNombre}" /></strong>
                                        <c:if test="${edicion.estado.descripcion ne 'Aceptada'}">
                                            <small class="text-muted d-block">Visible solo para el organizador</small>
                                        </c:if>
                                    </span>
                                    <c:choose>
                                        <c:when test="${edicion.estado.descripcion eq 'Aceptada'}">
                                            <span class="badge bg-success">Aceptada</span>
                                        </c:when>
                                        <c:when test="${edicion.estado.descripcion eq 'Ingresada'}">
                                            <span class="badge bg-warning text-dark">Ingresada</span>
                                        </c:when>
                                        <c:otherwise>
                                            <span class="badge bg-danger">Rechazada</span>
                                        </c:otherwise>
                                    </c:choose>
                                </a>
                            </c:forEach>
                        </div>
                    </div>
                </div>
            </c:if>

            <c:if test="${esAsistente and esPropio}">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <h2 class="h5 mb-3">Mis registros a ediciones</h2>

                        <c:if test="${empty registros}">
                            <p class="text-muted mb-0">Todavía no te registraste a ninguna edición.</p>
                        </c:if>

                        <div class="list-group">
                            <c:forEach var="registro" items="${registros}">
                                <c:url var="urlRegistro" value="/consulta-registro">
                                    <c:param name="edicion" value="${registro.nombreEdicion}" />
                                </c:url>
                                <a href="${urlRegistro}" class="list-group-item list-group-item-action">
                                    <strong><c:out value="${registro.nombreEdicion}" /></strong>
                                    <small class="text-muted d-block">
                                        <c:out value="${registro.nombreTipoRegistro}" /> ·
                                        $<c:out value="${registro.costo}" /> ·
                                        <c:out value="${registro.fecha}" />
                                    </small>
                                </a>
                            </c:forEach>
                        </div>
                    </div>
                </div>
            </c:if>

        </div>
    </div>
</main>

<script src="${raiz}/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
</file>

<file path="webapp/src/test/java/web/PatrociniosAutorizacionTest.java">
package web;

import contratos.dto.NivelPatrocinio;
import contratos.dto.*;
import web.PortalDoble.Datos;
import datatypes.Actor;
import jakarta.servlet.RequestDispatcher;
import jakarta.servlet.ServletContext;
import jakarta.servlet.http.*;
import org.junit.jupiter.api.Test;

import java.lang.reflect.InvocationHandler;
import java.lang.reflect.Proxy;
import java.time.LocalDate;
import java.util.*;

import static org.junit.jupiter.api.Assertions.*;

class PatrociniosAutorizacionTest {
    @Test
    void propietarioCreaEnLosTresEstadosUsandoSoloSuSesion() throws Exception {
        for (EstadoEdicion estado : EstadoEdicion.values()) {
            Escenario e = new Escenario(estado);
            e.autenticar(organizador("duenio"));
            e.parametros.put("organizador", "ajeno");
            PortalDoble.http(()->new AltaPatrocinioServlet().doPost(e.request,e.response),e.request,e.response);
            assertEquals(1, e.altas);
            assertEquals(302, e.estado);
            assertEquals("Edicion", e.creado.getNombreEdicion());
            assertEquals("duenio", e.actorRecibido.nickname());
            assertFalse(e.actorRecibido.esAdministradorLocal());
        }
    }

    @Test
    void organizadorAjenoNoPuedeCrearAunqueManipuleLaIdentidad() throws Exception {
        for (EstadoEdicion estado : EstadoEdicion.values()) {
            Escenario e = new Escenario(estado);
            e.autenticar(organizador("ajeno"));
            e.parametros.put("organizador", "duenio");
            e.parametros.put("nickname", "duenio");
            e.parametros.put("usuario", "duenio");
            e.sesion.put("usuarioLogueado", organizador("duenio"));
            PortalDoble.http(()->new AltaPatrocinioServlet().doPost(e.request,e.response),e.request,e.response);
            assertAltaRechazada(e);
        }
    }

    @Test
    void visitanteYAsistenteNoPuedenCrear() throws Exception {
        for (DtUsuario usuario : new DtUsuario[]{null, asistente("asistente"), asistente("duenio")}) {
            Escenario e = new Escenario(EstadoEdicion.ACEPTADA);
            if (usuario != null) e.autenticar(usuario);
            PortalDoble.http(()->new AltaPatrocinioServlet().doPost(e.request,e.response),e.request,e.response);
            assertAltaRechazada(e);
        }
    }

    @Test
    void elAtributoDeSesionAntiguoNoAutorizaElAlta() throws Exception {
        Escenario e = new Escenario(EstadoEdicion.ACEPTADA);
        e.tieneSesion = true;
        e.sesion.put("usuarioLogueado", organizador("duenio"));
        PortalDoble.http(()->new AltaPatrocinioServlet().doPost(e.request,e.response),e.request,e.response);
        assertAltaRechazada(e);
    }

    @Test
    void altaRechazaEdicionInexistenteVaciaOConOtraCapitalizacion() throws Exception {
        for (String nombre : new String[]{"Inexistente", "EDICION", "", " "}) {
            Escenario e = new Escenario(EstadoEdicion.ACEPTADA);
            e.autenticar(organizador("duenio"));
            e.parametros.put("edicion", nombre);
            PortalDoble.http(()->new AltaPatrocinioServlet().doPost(e.request,e.response),e.request,e.response);
            assertAltaRechazada(e);
        }
    }

    @Test
    void elFormularioExigeOrganizador() throws Exception {
        Escenario e = new Escenario(EstadoEdicion.ACEPTADA);
        PortalDoble.http(()->new AltaPatrocinioServlet().doGet(e.request,e.response),e.request,e.response);
        assertAltaRechazada(e);
    }

    @Test
    void tercerosConsultanAceptadasSinRecibirElCodigo() throws Exception {
        for (DtUsuario usuario : new DtUsuario[]{null, asistente("asistente"),
                organizador("ajeno"), asistente("duenio")}) {
            Escenario e = new Escenario(EstadoEdicion.ACEPTADA);
            if (usuario != null) e.autenticar(usuario);
            PortalDoble.http(()->new ConsultaPatrocinioServlet().doGet(e.request,e.response),e.request,e.response);
            assertPublicoSinCodigo(e);
        }
    }

    @Test
    void propietarioDeSesionVeElCodigoEnLosTresEstados() throws Exception {
        for (EstadoEdicion estado : EstadoEdicion.values()) {
            Escenario e = new Escenario(estado);
            e.autenticar(organizador("duenio"));
            PortalDoble.http(()->new ConsultaPatrocinioServlet().doGet(e.request,e.response),e.request,e.response);
            assertEquals(200, e.estado);
            assertTrue(e.reenviado);
            assertEquals(true, e.atributos.get("esOrganizadorDuenio"));
            assertEquals("SECRETO-UTEC", ((DtPatrocinio) e.atributos.get("patrocinio")).getCodigoPatrocinio());
        }
    }

    @Test
    void tercerosNoPuedenConsultarEdicionesOcultas() throws Exception {
        for (EstadoEdicion estado : new EstadoEdicion[]{EstadoEdicion.INGRESADA, EstadoEdicion.RECHAZADA}) {
            for (DtUsuario usuario : new DtUsuario[]{null, asistente("asistente"), organizador("ajeno")}) {
                Escenario e = new Escenario(estado);
                if (usuario != null) e.autenticar(usuario);
                PortalDoble.http(()->new ConsultaPatrocinioServlet().doGet(e.request,e.response),e.request,e.response);
                assertOculto(e);
                assertEquals(0, e.consultas);
            }
        }
    }

    @Test
    void parametrosYElAtributoAntiguoNoSuplantanAlDuenioEnConsulta() throws Exception {
        Escenario e = new Escenario(EstadoEdicion.ACEPTADA);
        e.autenticar(organizador("ajeno"));
        e.sesion.put("usuarioLogueado", organizador("duenio"));
        e.parametros.put("usuario", "duenio");
        e.parametros.put("organizador", "duenio");
        e.parametros.put("esOrganizadorDuenio", "true");
        PortalDoble.http(()->new ConsultaPatrocinioServlet().doGet(e.request,e.response),e.request,e.response);
        assertPublicoSinCodigo(e);
    }

    @Test
    void elAtributoAntiguoSoloNoAutorizaUnaEdicionOculta() throws Exception {
        Escenario e = new Escenario(EstadoEdicion.INGRESADA);
        e.tieneSesion = true;
        e.sesion.put("usuarioLogueado", organizador("duenio"));
        PortalDoble.http(()->new ConsultaPatrocinioServlet().doGet(e.request,e.response),e.request,e.response);
        assertOculto(e);
        assertEquals(0, e.consultas);
    }

    @Test
    void consultaDeEdicionInexistenteOConOtraCapitalizacionDevuelve404() throws Exception {
        for (String nombre : new String[]{"Inexistente", "EDICION"}) {
            Escenario e = new Escenario(EstadoEdicion.ACEPTADA);
            e.autenticar(organizador("duenio"));
            e.parametros.put("edicion", nombre);
            PortalDoble.http(()->new ConsultaPatrocinioServlet().doGet(e.request,e.response),e.request,e.response);
            assertOculto(e);
            assertEquals(0, e.consultas);
        }
    }

    @Test
    void edicionOcultaTambienSeProtegeSinInstitucion() throws Exception {
        Escenario e = new Escenario(EstadoEdicion.RECHAZADA);
        e.parametros.remove("institucion");
        PortalDoble.http(()->new ConsultaPatrocinioServlet().doGet(e.request,e.response),e.request,e.response);
        assertOculto(e);
    }

    @Test
    void patrocinioInexistenteDevuelve404() throws Exception {
        Escenario e = new Escenario(EstadoEdicion.ACEPTADA);
        e.existePatrocinio = false;
        PortalDoble.http(()->new ConsultaPatrocinioServlet().doGet(e.request,e.response),e.request,e.response);
        assertOculto(e);
    }

    @Test
    void consultaSinSeleccionSigueSiendoPublica() throws Exception {
        Escenario e = new Escenario(EstadoEdicion.ACEPTADA);
        e.parametros.clear();
        PortalDoble.http(()->new ConsultaPatrocinioServlet().doGet(e.request,e.response),e.request,e.response);
        assertEquals(200, e.estado);
        assertTrue(e.reenviado);
        assertEquals(0, e.consultas);
    }

    private static void assertAltaRechazada(Escenario e) {
        assertEquals(403, e.estado);
        assertEquals(0, e.altas);
        assertFalse(e.reenviado);
    }

    private static void assertOculto(Escenario e) {
        assertEquals(404, e.estado);
        assertFalse(e.reenviado);
        assertFalse(e.atributos.containsKey("patrocinio"));
    }

    private static void assertPublicoSinCodigo(Escenario e) {
        assertEquals(200, e.estado);
        assertTrue(e.reenviado);
        assertEquals(false, e.atributos.get("esOrganizadorDuenio"));
        DtPatrocinio visible = (DtPatrocinio) e.atributos.get("patrocinio");
        assertNotNull(visible);
        assertNull(visible.getCodigoPatrocinio());
        assertEquals("UTEC", visible.getNombreInstituto());
        assertEquals("General", visible.getNombreTipoRegistro());
        assertEquals(5000f, visible.getMontoAporte());
        assertEquals("SECRETO-UTEC", e.patrocinio.getCodigoPatrocinio(), "El DTO original debe conservarse.");
    }

    private static DtOrganizador organizador(String nick) {
        return new DtOrganizador(nick, nick, nick + "@ejemplo.uy", "Descripción", "");
    }

    private static DtAsistente asistente(String nick) {
        return new DtAsistente(nick, nick, nick + "@ejemplo.uy", "Apellido", LocalDate.of(2000, 1, 1), null);
    }

    // Dobles estrictos de las interfaces existentes; no necesitan base ni bibliotecas de mocks.
    static final class Escenario {
        final Map<String, String> parametros = new HashMap<>();
        final Map<String, Object> atributos = new HashMap<>();
        final Map<String, Object> sesion = new HashMap<>();
        final List<DtEdicion> ediciones = new ArrayList<>();
        final List<DtEvento> eventos = new ArrayList<>(List.of(new DtEvento("Evento", "EV", "Descripción", LocalDate.now(), List.of())));
        final Map<String, List<DtEdicion>> edicionesPorEvento = new HashMap<>();
        final Map<String, List<DtTipoRegistro>> tiposPorEdicion = new HashMap<>();
        String errorAlta;
        String redireccion;
        boolean tieneSesion;
        int estado = 200;
        int altas;
        int consultas;
        boolean reenviado;
        DtPatrocinio creado;
        Actor actorRecibido;
        Actor actorConsulta;
        boolean existePatrocinio = true;
        final DtPatrocinio patrocinio = new DtPatrocinio(LocalDate.now(), 5000, 1,
                "SECRETO-UTEC", NivelPatrocinio.ORO, "UTEC", "Edicion", "General");
        final Datos sistema = doble(Datos.class, (p, m, a) -> switch (m.getName()) {
            case "listarEventos" -> eventos;
            case "consultarUsuario" -> organizador((String) a[0]);
            case "obtenerImagen" -> null;
            case "obtenerRegistrosEdicion" -> List.of();
            case "obtenerEdicionesEvento" -> edicionesPorEvento.getOrDefault(a[0], List.of());
            case "obtenerEdicionesOrganizador" -> ediciones.stream()
                    .filter(e -> Objects.equals(e.getNombreOrganizador(), a[0])).toList();
            case "listarInstituciones" -> List.of(new DtInstitucion("UTEC", "Institución", "https://utec.edu.uy"));
            case "obtenerTiposRegistroEdicion" -> tiposPorEdicion.getOrDefault(a[0], List.of());
            case "consultarTipoRegistro" -> tiposPorEdicion.getOrDefault(a[0], List.of()).stream()
                    .filter(t -> t.getIdNombre().equals(a[1])).findFirst().orElse(null);
            case "obtenerInstitucionesPatrocinadoras" -> existePatrocinio ? List.of("UTEC") : List.of();
            case "consultarPatrocinios" -> {
                actorConsulta = (Actor) a[3];
                yield consultaDelDoble((String) a[0], (String) a[1], (String) a[2], actorConsulta);
            }
            case "altaPatrocinio" -> {
                creado = (DtPatrocinio) a[0];
                actorRecibido = (Actor) a[2];
                // Doble del contrato: la autorización real se verifica con Sistema y persistencia en lógica.
                comprobarDestino(creado.getNombreEdicion(), actorRecibido);
                if (a[1] != null && !((String) a[1]).isEmpty() && edicionesPorEvento.getOrDefault(a[1], List.of())
                        .stream().noneMatch(e -> e.getIdNombre().equals(creado.getNombreEdicion()))) {
                    throw new IllegalArgumentException("La edición no pertenece al evento seleccionado.");
                }
                for(String campo:List.of("institucion","tipoRegistro","codigo"))if(parametros.getOrDefault(campo,"").isBlank())throw new IllegalArgumentException("Todos los campos son obligatorios.");
                if (errorAlta != null) throw new IllegalArgumentException(errorAlta);
                altas++; yield true;
            }
            case "obtenerOpcionesAltaPatrocinio" -> {
                String evento = (String) a[0], edicion = (String) a[1];
                Actor actor = (Actor) a[2];
                if (!edicion.isEmpty()) {
                    comprobarDestino(edicion, actor);
                    for (var entrada : edicionesPorEvento.entrySet()) {
                        if (entrada.getValue().stream().anyMatch(e -> edicion.equals(e.getIdNombre()))) {
                            evento = entrada.getKey(); break;
                        }
                    }
                }
                yield PortalDoble.opciones(evento, eventos,
                        edicionesPorEvento.getOrDefault(evento, List.of()).stream()
                                .filter(e -> actor.nickname().equals(e.getNombreOrganizador())).toList(),
                        tiposPorEdicion.getOrDefault(edicion, List.of()),
                        List.of(new DtInstitucion("UTEC", "Institución", "https://utec.edu.uy")));
            }
            default -> throw new AssertionError("Llamada inesperada a Datos: " + m.getName());
        });
        final ServletContext contexto = doble(ServletContext.class, (p, m, a) -> {
            if (m.getName().equals("getAttribute") && a[0].equals("central")) return PortalDoble.crear(sistema,tieneSesion?sesion:Map.of());
            throw new AssertionError("Llamada inesperada al contexto: " + m.getName());
        });
        final HttpSession httpSesion = doble(HttpSession.class, (p, m, a) -> {
            if (m.getName().equals("getAttribute")) return sesion.get(a[0]);
            throw new AssertionError("Llamada inesperada a la sesión: " + m.getName());
        });
        final RequestDispatcher despachador = doble(RequestDispatcher.class, (p, m, a) -> {
            if (m.getName().equals("forward")) { reenviado = true; return null; }
            throw new AssertionError("Llamada inesperada al despachador: " + m.getName());
        });
        final HttpServletRequest request = doble(HttpServletRequest.class, (p, m, a) -> switch (m.getName()) {
            case "getSession" -> {
                if (a == null || a.length != 1 || !Boolean.FALSE.equals(a[0]))
                    throw new AssertionError("No se debe crear una sesión para autorizar.");
                yield tieneSesion ? httpSesion : null;
            }
            case "getServletContext" -> contexto;
            case "getParameter" -> parametros.get(a[0]);
            case "setAttribute" -> { atributos.put((String) a[0], a[1]); yield null; }
            case "getAttribute" -> atributos.get(a[0]);
            case "getContextPath" -> "/eventos";
            case "getRequestDispatcher" -> despachador;
            default -> throw new AssertionError("Llamada inesperada a la petici?n: " + m.getName());
        });
        final HttpServletResponse response = doble(HttpServletResponse.class, (p, m, a) -> switch (m.getName()) {
            case "sendError" -> { estado = (Integer) a[0]; yield null; }
            case "sendRedirect" -> { estado = 302; redireccion = (String) a[0]; yield null; }
            default -> throw new AssertionError("Llamada inesperada a la respuesta: " + m.getName());
        });

        Escenario(EstadoEdicion estado) {
            LocalDate hoy = LocalDate.now();
            DtEdicion edicion = new DtEdicion("Edicion", "ED", hoy, hoy, hoy, "Montevideo", "Uruguay", "duenio");
            edicion.setEstado(estado);
            ediciones.add(edicion);
            edicionesPorEvento.put("Evento", ediciones);
            tiposPorEdicion.put("Edicion", List.of(new DtTipoRegistro("General", "General", 100, 50)));
            parametros.putAll(Map.of("edicion", "Edicion", "institucion", "UTEC", "nivel", "ORO",
                    "tipoRegistro", "General", "aporte", "5000", "registrograt", "1", "codigo", "NUEVO"));
        }

        void autenticar(DtUsuario usuario) {
            tieneSesion = true;
            sesion.put("usuario", usuario);
        }

        private void comprobarDestino(String edicion, Actor actor) {
            if (ediciones.stream().noneMatch(e -> e.getIdNombre().equals(edicion)
                    && actor.esOrganizador() && actor.nickname().equals(e.getNombreOrganizador()))) {
                throw new excepciones.AccesoDenegadoException("La edición no pertenece al organizador.");
            }
        }

        // Solo doble de adaptación HTTP. La política real se prueba contra Sistema y PostgreSQL en lógica.
        private DtConsultaPatrocinios consultaDelDoble(String evento, String edicion, String institucion, Actor actor) {
            DtEdicion seleccionada = ediciones.stream().filter(e -> edicion.equals(e.getIdNombre())).findFirst().orElse(null);
            boolean propio = seleccionada != null && actor != null && actor.esOrganizador()
                    && Objects.equals(actor.nickname(), seleccionada.getNombreOrganizador());
            DtPatrocinio visible = null;
            List<String> instituciones = List.of();
            if (!edicion.isEmpty()) {
                if (seleccionada == null || (seleccionada.getEstado() != EstadoEdicion.ACEPTADA && !propio)) return null;
                for (var entrada : edicionesPorEvento.entrySet()) {
                    if (entrada.getValue().contains(seleccionada)) { evento = entrada.getKey(); break; }
                }
                instituciones = existePatrocinio ? List.of("UTEC") : List.of();
                if (!institucion.isEmpty()) {
                    consultas++;
                    if (!existePatrocinio) return null;
                    visible = new DtPatrocinio(patrocinio.getFecha(), patrocinio.getMontoAporte(),
                            patrocinio.getCantRegistrosGrat(), propio ? patrocinio.getCodigoPatrocinio() : null,
                            patrocinio.getNivel(), patrocinio.getNombreInstituto(), patrocinio.getNombreEdicion(),
                            patrocinio.getNombreTipoRegistro());
                }
            }
            List<DtEdicion> opciones = new ArrayList<>(edicionesPorEvento.getOrDefault(evento, List.of()).stream()
                    .filter(e -> e.getEstado() == EstadoEdicion.ACEPTADA).toList());
            if (seleccionada != null && seleccionada.getEstado() != EstadoEdicion.ACEPTADA) opciones.add(seleccionada);
            return PortalDoble.consulta(evento, eventos, opciones, instituciones, visible, propio);
        }
    }

    private static <T> T doble(Class<T> tipo, InvocationHandler manejador) {
        return tipo.cast(Proxy.newProxyInstance(tipo.getClassLoader(), new Class<?>[]{tipo}, manejador));
    }
}
