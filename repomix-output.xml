    @WebMethod
    @jakarta.xml.ws.RequestWrapper(className="central.soap.portal.jaxws.ConsultarPerfil")
    @jakarta.xml.ws.ResponseWrapper(className="central.soap.portal.jaxws.ConsultarPerfilResponse")
