<file path="webapp/src/main/webapp/js/alta-patrocinio.js">
"use strict";
// Los formularios GET solo contienen la selección; el código nunca va a la URL.
document.querySelectorAll("[data-seleccion-patrocinio]").forEach(form => {
    form.querySelector("select").addEventListener("change", () => form.requestSubmit());
});
const formulario = document.getElementById("formAltaPatrocinio");
if (formulario) {
    const aporte = formulario.elements.aporte;
    const gratuitos = formulario.elements.registrograt;
    const codigo = formulario.elements.codigo;
    const tipo = formulario.elements.tipoRegistro;
    function validar() {
        const monto = Number(aporte.value.trim());
        const cantidad = Number(gratuitos.value.trim());
        aporte.setCustomValidity(/^[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?$/.test(aporte.value.trim())
            && Number.isFinite(Math.fround(monto)) && Math.fround(monto) > 0 ? "" : "Ingresá un aporte finito mayor que cero.");
        gratuitos.setCustomValidity(/^\d+$/.test(gratuitos.value.trim()) && Number.isSafeInteger(cantidad)
            && cantidad <= 2147483647 ? "" : "Ingresá una cantidad entera no negativa.");
        codigo.setCustomValidity(codigo.value.trim() ? "" : "Ingresá el código de patrocinio.");
        const costo = Number(tipo.selectedOptions[0]?.dataset.costo);
        const total = costo * cantidad;
        const limite = monto * 0.20;
        if (aporte.validity.valid && gratuitos.validity.valid && Number.isFinite(costo)
                && total - limite > Math.max(1, Math.abs(total), Math.abs(limite)) * 1e-7) {
            gratuitos.setCustomValidity("El costo de los registros gratuitos supera el 20 % del aporte.");
        }
    }
    [aporte, gratuitos, codigo, tipo].forEach(campo => {
        campo.addEventListener("input", validar);
        campo.addEventListener("change", validar);
    });
    formulario.addEventListener("submit", evento => {
        validar();
        if (!formulario.reportValidity()) evento.preventDefault();
    });
}
</file>

<file path="webapp/src/main/webapp/js/disponibilidad-usuarios.js">
(() => {
    const form = document.getElementById('formAltaUsuario');
    if (!form) return;
    for (const campo of ['nickname', 'correo']) {
        const input = document.getElementById(campo);
        const mensaje = document.getElementById(`disponibilidad-${campo}`);
        let temporizador;
        let peticion;
        let version = 0;
        input.addEventListener('input', () => {
            const actual = ++version;
            clearTimeout(temporizador);
            if (peticion) peticion.abort();
            input.setCustomValidity('');
            mensaje.textContent = '';
            mensaje.className = 'form-text';
            const valor = input.value.trim();
            if (!valor || !input.validity.valid) return;
            mensaje.textContent = 'Consultando disponibilidad…';
            temporizador = setTimeout(async () => {
                peticion = new AbortController();
                const url = new URL(form.dataset.disponibilidadUrl, window.location.origin);
                url.searchParams.set('campo', campo);
                url.searchParams.set('valor', valor);
                try {
                    const respuesta = await fetch(url, {signal: peticion.signal, cache: 'no-store', headers: {'Accept': 'application/json'}});
                    if (!respuesta.ok) throw new Error('Sin respuesta');
                    const datos = await respuesta.json();
                    if (actual !== version || input.value.trim() !== valor) return;
                    if (typeof datos.disponible !== 'boolean') throw new Error('Respuesta inválida');
                    mensaje.textContent = datos.disponible ? 'Disponible.' : 'No disponible o no válido.';
                    mensaje.className = datos.disponible ? 'form-text text-success' : 'form-text text-danger';
                    input.setCustomValidity(datos.disponible ? '' : 'Este valor no está disponible o no es válido.');
                } catch (error) {
                    if (error.name === 'AbortError' || actual !== version || input.value.trim() !== valor) return;
                    mensaje.textContent = 'No pudimos verificarlo ahora. Se comprobará al registrar el usuario.';
                    mensaje.className = 'form-text text-muted';
                    input.setCustomValidity('');
                }
            }, 350);
        });
        if (input.value) input.dispatchEvent(new Event('input'));
    }
})();
</file>

