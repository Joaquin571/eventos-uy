<jsp:include page="/WEB-INF/views/fragmentos/csrf.jsp"/>
<label class="form-label">Evento<select name="evento" class="form-select" required><option value="">Seleccione un evento</option>
<c:forEach var="e" items="${eventos}"><option value="<c:out value='${e.nombre}'/>" <c:if test="${form.evento eq e.nombre}">selected</c:if>><c:out value="${e.nombre}"/></option></c:forEach></select></label>
<label class="form-label">Nombre de edición<input name="nombre" value="<c:out value='${form.nombre}'/>" class="form-control" required></label>
<label class="form-label">Sigla<input name="sigla" value="<c:out value='${form.sigla}'/>" class="form-control" required></label>
<label class="form-label">Ciudad<input name="ciudad" value="<c:out value='${form.ciudad}'/>" class="form-control" required></label>
<label class="form-label">País<input name="pais" value="<c:out value='${form.pais}'/>" class="form-control" required></label>
<label class="form-label">Fecha de inicio<input type="date" name="fechaInicio" value="<c:out value='${form.fechaInicio}'/>" class="form-control" required></label>
<label class="form-label">Fecha de fin<input type="date" name="fechaFin" value="<c:out value='${form.fechaFin}'/>" class="form-control" required></label>
<label class="form-label">Imagen opcional<input type="file" name="imagen" accept="image/png,image/jpeg,image/gif,image/webp" class="form-control"></label>
<div class="mt-3"><button class="btn btn-primary">Confirmar alta</button> <a class="btn btn-outline-secondary" href="${raiz}/">Cancelar</a></div></form>
</main><script src="${raiz}/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="${raiz}/js/alta-edicion-fechas.js"></script><script src="${raiz}/js/validacion-formularios.js"></script>
</body></html>
</file>

<file path="webapp/src/main/webapp/WEB-INF/views/alta-patrocinio.jsp">
<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="raiz" value="${pageContext.request.contextPath}" />
<!doctype html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Patrocinios | eventos.uy</title>
<link rel="stylesheet" href="${raiz}/vendor/bootstrap/css/bootstrap.min.css">
<link rel="stylesheet" href="${raiz}/css/styles.css"></head><body>
<jsp:include page="/WEB-INF/views/fragmentos/cabezal.jsp" />
<main class="container py-4">
<h1>Alta de patrocinio</h1>
<c:if test="${not empty error}"><div class="alert alert-danger" role="alert"><c:out value="${error}" /></div></c:if>
<form method="get" action="${raiz}/alta-patrocinio" class="card card-body mb-3" data-seleccion-patrocinio>
<label for="evento" class="form-label">Evento</label>
<select id="evento" name="evento" class="form-select" required><option value="">Seleccione un evento</option>
<c:forEach var="e" items="${eventos}"><option value="<c:out value='${e.nombre}'/>" ${e.nombre eq form.evento ? 'selected' : ''}><c:out value="${e.nombre}"/></option></c:forEach></select>
<button class="btn btn-outline-primary mt-2">Ver mis ediciones</button>
<c:if test="${empty eventos}"><p class="mt-2">No hay eventos disponibles.</p></c:if>
</form>
<c:if test="${not empty form.evento}">
<form method="get" action="${raiz}/alta-patrocinio" class="card card-body mb-3" data-seleccion-patrocinio>
<input type="hidden" name="evento" value="<c:out value='${form.evento}'/>">
<label for="edicion" class="form-label">Edición propia</label>
<select id="edicion" name="edicion" class="form-select" required><option value="">Seleccione una edición</option>
<c:forEach var="e" items="${ediciones}"><option value="<c:out value='${e.idNombre}'/>" ${e.idNombre eq form.edicion ? 'selected' : ''}><c:out value="${e.idNombre}"/> — <c:out value="${e.estado}"/></option></c:forEach></select>
<button class="btn btn-outline-primary mt-2">Continuar</button>
<c:if test="${empty ediciones}"><p class="mt-2">No organizás ediciones de este evento.</p></c:if>
</form></c:if>
<c:if test="${not empty form.edicion}">
<form id="formAltaPatrocinio" method="post" action="${raiz}/alta-patrocinio" class="card card-body">
<jsp:include page="/WEB-INF/views/fragmentos/csrf.jsp"/>
<h2 class="h4"><c:out value="${form.edicion}"/></h2>
<input type="hidden" name="evento" value="<c:out value='${form.evento}'/>">
<input type="hidden" name="edicion" value="<c:out value='${form.edicion}'/>">
<label for="institucion" class="form-label mt-2">Institución</label>
<select id="institucion" name="institucion" class="form-select" required><option value="">Seleccione una institución</option>
<c:if test="${institucionNoDisponible}"><option selected disabled value="<c:out value='${form.institucion}'/>"><c:out value="${form.institucion}"/> (no disponible)</option></c:if>
<c:forEach var="i" items="${instituciones}"><option value="<c:out value='${i.nombre}'/>" ${i.nombre eq form.institucion ? 'selected' : ''}><c:out value="${i.nombre}"/></option></c:forEach></select>
<label for="nivel" class="form-label mt-2">Nivel de patrocinio</label>
<select id="nivel" name="nivel" class="form-select" required><option value="">Seleccione un nivel</option>
<c:if test="${nivelNoDisponible}"><option selected disabled value="<c:out value='${form.nivel}'/>"><c:out value="${form.nivel}"/> (no disponible)</option></c:if>
<c:forEach var="n" items="${niveles}"><option value="<c:out value='${n}'/>" ${n.toString() eq form.nivel ? 'selected' : ''}><c:out value="${n}"/></option></c:forEach></select>
<label for="tipoRegistro" class="form-label mt-2">Tipo de registro</label>
<select id="tipoRegistro" name="tipoRegistro" class="form-select" required><option value="">Seleccione un tipo de registro</option>
<c:if test="${tipoNoDisponible}"><option selected disabled value="<c:out value='${form.tipoRegistro}'/>"><c:out value="${form.tipoRegistro}"/> (no disponible)</option></c:if>
<c:forEach var="t" items="${tipos}"><option value="<c:out value='${t.idNombre}'/>" data-costo="<c:out value='${t.costo}'/>" ${t.idNombre eq form.tipoRegistro ? 'selected' : ''}><c:out value="${t.idNombre}"/> — $<c:out value="${t.costo}"/></option></c:forEach></select>
<label for="aporte" class="form-label mt-2">Aporte económico (use punto decimal)</label>
<input id="aporte" name="aporte" type="text" inputmode="decimal" class="form-control" required value="<c:out value='${form.aporte}'/>">
<label for="registrograt" class="form-label mt-2">Cantidad de registros gratuitos</label>
<input id="registrograt" name="registrograt" type="text" inputmode="numeric" class="form-control" required value="<c:out value='${form.registrograt}'/>">
<label for="codigo" class="form-label mt-2">Código de patrocinio</label>
<input id="codigo" name="codigo" class="form-control" required value="<c:out value='${form.codigo}'/>">
<c:if test="${empty tipos}"><p class="alert alert-info mt-3">La edición no tiene tipos de registro. Creá uno antes de registrar un patrocinio.</p></c:if>
<c:if test="${empty instituciones}"><p class="alert alert-info mt-3">No hay instituciones disponibles. Creá una antes de registrar un patrocinio.</p></c:if>
<div class="d-flex gap-2 mt-3"><button class="btn btn-primary" ${empty tipos or empty instituciones ? 'disabled' : ''}>Dar de alta</button>
<a href="${raiz}/" class="btn btn-secondary">Cancelar</a></div>
</form></c:if>
<script src="${raiz}/js/alta-patrocinio.js"></script>
</main><script src="${raiz}/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="${raiz}/js/validacion-formularios.js"></script>
</body></html>
</file>

<file path="webapp/src/main/webapp/WEB-INF/views/alta-tipo-registro.jsp">
<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="raiz" value="${pageContext.request.contextPath}" />
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Alta de tipo de registro | eventos.uy</title>
<link rel="stylesheet" href="${raiz}/vendor/bootstrap/css/bootstrap.min.css">
<link rel="stylesheet" href="${raiz}/css/styles.css"></head><body>
<jsp:include page="/WEB-INF/views/fragmentos/cabezal.jsp"/>
<main class="container py-4"><h1>Alta de tipo de registro</h1>
<c:if test="${not empty error}"><div class="alert alert-danger"><c:out value="${error}"/></div></c:if>
<c:if test="${not empty exito}"><div class="alert alert-success"><c:out value="${exito}"/></div></c:if>
<c:if test="${not empty advertencia}"><div class="alert alert-warning"><c:out value="${advertencia}"/></div></c:if>
<form id="formAltaTipoRegistro" method="post" action="${raiz}/alta-tipo-registro" class="card card-body">
<jsp:include page="/WEB-INF/views/fragmentos/csrf.jsp"/>
<label class="form-label">Edición<select id="tipoEdicion" name="edicion" class="form-select" required aria-describedby="tipoEdicionError"><option value="">Seleccione una edición propia</option>
<c:forEach var="e" items="${ediciones}"><option value="<c:out value='${e.idNombre}'/>" <c:if test="${form.edicion eq e.idNombre}">selected</c:if>><c:out value="${e.idNombre}"/></option></c:forEach></select></label>
<div id="tipoEdicionError" class="invalid-feedback d-block" aria-live="polite"></div>
<label class="form-label">Nombre<input id="tipoNombre" name="nombre" value="<c:out value='${form.nombre}'/>" class="form-control" required aria-describedby="tipoNombreError"></label>
<div id="tipoNombreError" class="invalid-feedback d-block" aria-live="polite"></div>
<label class="form-label">Descripción<textarea id="tipoDescripcion" name="descripcion" class="form-control" required aria-describedby="tipoDescripcionError"><c:out value="${form.descripcion}"/></textarea></label>
<div id="tipoDescripcionError" class="invalid-feedback d-block" aria-live="polite"></div>
<label class="form-label">Costo<input id="tipoCosto" name="costo" value="<c:out value='${form.costo}'/>" type="number" min="0" step="0.01" class="form-control" required aria-describedby="tipoCostoError"></label>
<div id="tipoCostoError" class="invalid-feedback d-block" aria-live="polite"></div>
<label class="form-label">Cupo<input id="tipoCupo" name="cupo" value="<c:out value='${form.cupo}'/>" type="number" min="1" step="1" class="form-control" required aria-describedby="tipoCupoError"></label>
<div id="tipoCupoError" class="invalid-feedback d-block" aria-live="polite"></div>
<div class="mt-3"><button class="btn btn-primary">Confirmar alta</button> <a class="btn btn-outline-secondary" href="${raiz}/">Cancelar</a></div></form>
</main><script src="${raiz}/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="${raiz}/js/validacion-altas.js"></script></body></html>
</file>

<file path="webapp/src/main/webapp/WEB-INF/views/edicion.jsp">
<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="raiz" value="${pageContext.request.contextPath}" />
<!doctype html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Consultas | eventos.uy</title>
<link rel="stylesheet" href="${raiz}/vendor/bootstrap/css/bootstrap.min.css">
<link rel="stylesheet" href="${raiz}/css/styles.css"></head><body>
<jsp:include page="/WEB-INF/views/fragmentos/cabezal.jsp" />
<main class="container py-4">
<h1>Consulta de edición</h1>
<c:url var="urlConsulta" value="/edicion"/>
<form method="get" action="${urlConsulta}" class="card card-body mb-3" data-selector-consulta>
<label for="evento" class="form-label">Evento</label>
<select id="evento" name="evento" class="form-select" required><option value="">Seleccione un evento</option>
<c:forEach var="e" items="${eventos}"><option value="<c:out value='${e.nombre}'/>" ${e.nombre eq eventoElegido ? 'selected' : ''}><c:out value="${e.nombre}"/></option></c:forEach></select>
<button class="btn btn-primary mt-2">Buscar ediciones</button></form>
<c:if test="${not empty eventoElegido}">
<div class="list-group mb-3">
<c:forEach var="e" items="${ediciones}"><c:url var="urlEd" value="/edicion"><c:param name="evento" value="${eventoElegido}"/><c:param name="nombre" value="${e.idNombre}"/></c:url>
<a class="list-group-item list-group-item-action" href="${urlEd}"><c:out value="${e.idNombre}"/></a></c:forEach>
<c:if test="${empty ediciones}"><p>No hay ediciones aceptadas para este evento.</p></c:if>
</div>
<c:url var="urlEvento" value="/evento"><c:param name="nombre" value="${eventoElegido}"/></c:url>
<a href="${urlEvento}" class="btn btn-outline-secondary mb-3">Volver al evento</a>
</c:if>
<c:if test="${not empty detalle}">
<article class="card card-body mb-3"><h2><c:out value="${detalle.idNombre}"/></h2>
<c:if test="${tieneImagen}"><c:url var="urlImagen" value="/imagen"><c:param name="tipo" value="edicion"/><c:param name="id" value="${detalle.idNombre}"/></c:url>
<img src="${urlImagen}" alt="Imagen de la edición" class="rounded mb-3" style="max-width: 320px; max-height: 240px; object-fit: contain;"></c:if>
<p>Estado: <c:out value="${detalle.estado}"/></p>
<p>Sigla: <c:out value="${detalle.sigla}"/></p>
<p>Ciudad: <c:out value="${detalle.ciudad}"/> — País: <c:out value="${detalle.pais}"/></p>
<c:url var="urlOrganizador" value="/usuario"><c:param name="nick" value="${detalle.nombreOrganizador}"/></c:url>
<p>Organizador: <a href="${urlOrganizador}"><c:out value="${empty organizador ? detalle.nombreOrganizador : organizador.nombre}"/></a></p>
<p>Inicio: <c:out value="${fechaInicio}"/> — Fin: <c:out value="${fechaFin}"/></p>
<p>Fecha de alta: <c:out value="${fechaAlta}"/></p>
<h3>Tipos de registro</h3><ul>
<c:forEach var="t" items="${tipos}"><c:url var="urlTipo" value="/tipo-registro"><c:param name="edicion" value="${detalle.idNombre}"/><c:param name="nombre" value="${t.idNombre}"/></c:url>
<li><a href="${urlTipo}"><c:out value="${t.idNombre}"/></a> — $<c:out value="${t.costo}"/> — Cupo: <c:out value="${t.cupo}"/></li></c:forEach>
</ul><c:if test="${empty tipos}"><p>Esta edición no tiene tipos de registro.</p></c:if>
<h3>Patrocinios</h3><ul>
<c:forEach var="i" items="${patrocinadoras}"><c:url var="urlPatrocinio" value="/consulta-patrocinio"><c:param name="edicion" value="${detalle.idNombre}"/><c:param name="institucion" value="${i}"/></c:url>
<li><a href="${urlPatrocinio}"><c:out value="${i}"/></a></li></c:forEach>
</ul><c:if test="${empty patrocinadoras}"><p>Esta edición no tiene patrocinios.</p></c:if>
<c:if test="${puedeRegistrarse}"><c:url var="urlRegistro" value="/registro-edicion"><c:param name="edicion" value="${detalle.idNombre}"/></c:url>
<a href="${urlRegistro}" class="btn btn-primary align-self-start">Registrarme</a></c:if>
</article>
<c:if test="${esPropietario}">
<section class="card card-body mb-3"><h3>Asistentes registrados</h3>
<c:if test="${empty registros}"><p>Esta edición no tiene asistentes registrados.</p></c:if>
<c:if test="${not empty registros}"><div class="table-responsive"><table class="table"><thead><tr><th>Asistente</th><th>Tipo</th><th>Fecha</th><th>Costo</th><th>Usó código</th></tr></thead><tbody>
<c:forEach var="r" items="${registros}"><c:url var="urlConsultaRegistro" value="/consulta-registro"><c:param name="edicion" value="${detalle.idNombre}"/><c:param name="asistente" value="${r.nickname}"/></c:url>
<c:url var="urlTipoRegistro" value="/tipo-registro"><c:param name="edicion" value="${detalle.idNombre}"/><c:param name="nombre" value="${r.nombreTipoRegistro}"/></c:url>
<tr><td><a href="${urlConsultaRegistro}"><c:out value="${r.nickname}"/></a></td><td><a href="${urlTipoRegistro}"><c:out value="${r.nombreTipoRegistro}"/></a></td><td><c:out value="${r.fecha}"/></td><td>$<c:out value="${r.costo}"/></td><td><c:out value="${r.usoCodigo}"/></td></tr>
</c:forEach></tbody></table></div></c:if>
<c:url var="urlRegistros" value="/consulta-registro"><c:param name="edicion" value="${detalle.idNombre}"/></c:url>
<a href="${urlRegistros}">Consultar registros de esta edición</a></section>
</c:if>
<c:if test="${not empty registroPropio}"><section class="card card-body mb-3"><h3>Mi registro</h3>
<c:url var="urlTipoPropio" value="/tipo-registro"><c:param name="edicion" value="${detalle.idNombre}"/><c:param name="nombre" value="${registroPropio.nombreTipoRegistro}"/></c:url>
<p>Tipo: <a href="${urlTipoPropio}"><c:out value="${registroPropio.nombreTipoRegistro}"/></a></p>
<p>Fecha de registro: <c:out value="${registroPropio.fecha}"/></p><p>Costo: $<c:out value="${registroPropio.costo}"/></p><p>Utilizó código de patrocinio: <c:out value="${registroPropio.usoCodigo}"/></p>
<c:url var="urlRegistroPropio" value="/consulta-registro"><c:param name="edicion" value="${detalle.idNombre}"/></c:url>
<a href="${urlRegistroPropio}">Consultar mi registro</a></section></c:if>
</c:if>
</main><script src="${raiz}/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="${raiz}/js/consultas-selectores.js"></script></body></html>
</file>

<file path="webapp/src/main/webapp/WEB-INF/views/modificar-usuario.jsp">
<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="raiz" value="${pageContext.request.contextPath}" />
<c:url var="urlImagen" value="/imagen">
    <c:param name="tipo" value="usuario" />
    <c:param name="id" value="${perfil.nickname}" />
</c:url>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modificar mis datos - eventos.uy</title>
    <link rel="stylesheet" href="${raiz}/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="${raiz}/css/styles.css">
</head>
<body class="bg-light">

<jsp:include page="/WEB-INF/views/fragmentos/cabezal.jsp" />

<main class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">

                    <h1 class="h3 fw-bold mb-4">Modificar mis datos</h1>

                    <c:if test="${not empty error}">
                        <div class="alert alert-danger"><c:out value="${error}" /></div>
                    </c:if>

                    <form id="formModificarUsuario" method="post"
                          action="${raiz}/modificar-usuario" enctype="multipart/form-data">
<jsp:include page="/WEB-INF/views/fragmentos/csrf.jsp"/>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Nickname</label>
                            <input type="text" class="form-control" disabled
                                   value="<c:out value='${perfil.nickname}' />">
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Correo electrónico</label>
                            <input type="text" class="form-control" disabled
                                   value="<c:out value='${perfil.correoElectronico}' />">
                        </div>

                        <div class="mb-3">
                            <label for="nombre" class="form-label fw-bold">Nombre *</label>
                            <input type="text" id="nombre" name="nombre" class="form-control" required
                                   value="<c:out value='${form.nombre}' />">
                        </div>

                        <c:if test="${esAsistente}">
                            <div class="mb-3">
                                <label for="apellido" class="form-label fw-bold">Apellido *</label>
                                <input type="text" id="apellido" name="apellido" class="form-control" required
                                       value="<c:out value='${form.apellido}' />">
                            </div>
                            <div class="mb-3">
                                <label for="fechaNac" class="form-label fw-bold">Fecha de nacimiento *</label>
                                <input type="date" id="fechaNac" name="fechaNac" class="form-control" required
                                       value="<c:out value='${form.fechaNac}' />">
                            </div>
                            <div class="mb-3">
                                <label for="institucion" class="form-label fw-bold">Institución</label>
                                <select id="institucion" name="institucion" class="form-select">
                                    <option value="">Ninguna</option>
                                    <c:forEach var="institucion" items="${instituciones}">
                                        <option value="<c:out value='${institucion.nombre}' />"
                                                ${form.institucion eq institucion.nombre ? 'selected' : ''}>
                                            <c:out value="${institucion.nombre}" />
                                        </option>
                                    </c:forEach>
                                </select>
                            </div>
                        </c:if>

                        <c:if test="${esOrganizador}">
                            <div class="mb-3">
                                <label for="descripcion" class="form-label fw-bold">Descripción general *</label>
                                <textarea id="descripcion" name="descripcion" class="form-control"
                                          rows="3" required><c:out value="${form.descripcion}" /></textarea>
                            </div>
                            <div class="mb-3">
                                <label for="sitioWeb" class="form-label fw-bold">Sitio web</label>
                                <input type="url" id="sitioWeb" name="sitioWeb" class="form-control"
                                       placeholder="https://ejemplo.com"
                                       value="<c:out value='${form.sitioWeb}' />">
                            </div>
                        </c:if>

                        <div class="mb-3">
                            <label class="form-label fw-bold d-block">Imagen actual</label>
                            <img src="${urlImagen}" alt="Imagen de perfil" class="rounded-circle mb-2"
                                 style="width: 96px; height: 96px; object-fit: cover;">
                            <input type="file" id="imagen" name="imagen" class="form-control"
                                   accept="image/png,image/jpeg,image/gif,image/webp">
                            <div class="form-text">Opcional. Si elegís una, reemplaza la actual. Hasta 2 MB.</div>
                        </div>

                        <hr>

                        <p class="text-muted small mb-2">Dejá la contraseña vacía si no querés cambiarla.</p>

                        <div class="mb-3">
                            <label for="contrasenia" class="form-label fw-bold">Nueva contraseña</label>
                            <input type="password" id="contrasenia" name="contrasenia" class="form-control">
                        </div>

                        <div class="mb-4">
                            <label for="confirmacion" class="form-label fw-bold">Confirmar nueva contraseña</label>
                            <input type="password" id="confirmacion" name="confirmacion" class="form-control">
                        </div>

                        <c:url var="urlPerfil" value="/usuario">
                            <c:param name="nick" value="${perfil.nickname}" />
                        </c:url>

                        <div class="d-grid gap-2">
