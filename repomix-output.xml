    @Test
    void tokenEnUrlSeRechazaAunqueCoincida() throws Exception {
        Escenario e = new Escenario(); e.prepararPost(); e.query = "%5Fcsrf=" + e.parametros[0];
        e.filtrar(); assertEquals(403, e.estado); assertEquals(0, e.continuaciones);
