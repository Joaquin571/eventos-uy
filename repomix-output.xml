package implementacion;

import clases.*;
import datatypes.*;
import interfaces.ISistema;
import manejadores.ManejadorEventos;
import manejadores.ManejadorInstituciones;
import manejadores.ManejadorPatrocinios;
import manejadores.ManejadorRegistros;
import manejadores.ManejadorUsuarios;
import manejadores.ManejadorImagenes;
import java.util.ArrayList;
import java.util.Collection;
import java.util.HashSet;
import java.util.List;
import java.util.Locale;
import java.util.Set;
import java.time.LocalDate;

public class Sistema implements ISistema {

    private final ManejadorUsuarios manejadorUsuarios;
    private final ManejadorInstituciones manejadorInstituciones;
    private final ManejadorEventos manejadorEventos;
    private final ManejadorPatrocinios manejadorPatrocinios;
    private final ManejadorRegistros manejadorRegistros;
    private final ManejadorImagenes manejadorImagenes;

    private void validarDatosUsuario(String nickname, String nombre, String correo) {
        validarTexto("nickname", nickname);
        validarTexto("nombre", nombre);
        validarTexto("correo", correo);
        if (nickname == null || nickname.isBlank()) {
            throw new IllegalArgumentException("El nickname es obligatorio.");
        }

        if (nombre == null || nombre.isBlank()) {
            throw new IllegalArgumentException("El nombre es obligatorio.");
        }

        if (correo == null || !correo.matches("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$")) {
            throw new IllegalArgumentException("El correo electrónico no es válido.");
        }

        if (manejadorUsuarios.existeUsuario(nickname)) {
            throw new IllegalArgumentException("Ya existe un usuario con ese nickname.");
        }

        if (manejadorUsuarios.existeCorreo(correo)) {
            throw new IllegalArgumentException("Ya existe un usuario con ese correo electrónico.");
        }
    }

    /** String JPA sin longitud explícita: varchar(255); PostgreSQL cuenta caracteres. */
    private void validarTexto(String campo, String valor) {
        if (valor != null && valor.codePointCount(0, valor.length()) > 255) {
            throw new IllegalArgumentException("El campo " + campo + " no puede superar los 255 caracteres.");
        }
        if (valor != null && valor.indexOf('\0') >= 0) {
            throw new IllegalArgumentException("El campo " + campo + " contiene un carácter no permitido.");
        }
    }

    private void validarObligatorio(String valor, String mensaje) {
        validarTexto("texto", valor);
        if (valor == null || valor.isBlank()) {
            throw new IllegalArgumentException(mensaje);
        }
    }

    private void validarNacimiento(LocalDate fecha) {
        if (fecha == null) {
            throw new IllegalArgumentException("La fecha de nacimiento es obligatoria.");
        }
        if (fecha.isAfter(LocalDate.now())) {
            throw new IllegalArgumentException("La fecha de nacimiento no puede ser futura.");
        }
    }

    private void validarContrasenia(String contrasenia, String confirmacion) {
        if (contrasenia == null || contrasenia.isEmpty()) {
            throw new IllegalArgumentException("La contraseña es obligatoria.");
        }

        if (!contrasenia.equals(confirmacion)) {
            throw new IllegalArgumentException("La contraseña y su confirmación no coinciden.");
        }
    }

    @Override
    public DtUsuario autenticar(String nicknameOCorreo, String contrasenia) {
        String mensaje = "El nickname, el correo o la contraseña no son correctos.";

        if (nicknameOCorreo == null || nicknameOCorreo.isBlank() || contrasenia == null) {
            throw new IllegalArgumentException(mensaje);
        }

        String identificador = nicknameOCorreo.trim();
        if (identificador.codePointCount(0, identificador.length()) > 255 || identificador.indexOf('\0') >= 0) {
            throw new IllegalArgumentException(mensaje);
        }
        Usuario coincidencia = null;
        int cantidad = 0;
        for (Usuario candidato : manejadorUsuarios.buscarPorNicknameOCorreo(identificador)) {
            if (candidato.contraseniaCoincide(contrasenia)) {
                coincidencia = candidato;
                cantidad++;
            }
        }
        // No se elige arbitrariamente una cuenta cuando también coincide la contraseña.
        if (cantidad != 1) throw new IllegalArgumentException(mensaje);
        return consultarUsuario(coincidencia.getNickname());
    }

    @Override
    public void cambiarContrasenia(String nickname, String nueva, String confirmacion, Actor actor) {
        autorizarTitular(actor, nickname);
        validarContrasenia(nueva, confirmacion);

        if (!manejadorUsuarios.cambiarContrasenia(nickname, nueva)) {
            throw new IllegalArgumentException("El usuario no existe.");
        }
    }

    public Sistema() {
        manejadorUsuarios = ManejadorUsuarios.getInstance();
        manejadorInstituciones = ManejadorInstituciones.getInstance();
        manejadorEventos = ManejadorEventos.getInstance();
        manejadorPatrocinios = ManejadorPatrocinios.getInstance();
        manejadorRegistros = ManejadorRegistros.getInstance();
        manejadorImagenes = ManejadorImagenes.getInstance();
    }

    // VALIDACIONES USUARIO
    @Override
    public boolean existeUsuario(String nickname) { return manejadorUsuarios.existeUsuario(nickname); }
    @Override
    public boolean existeCorreoElectronico(String correoElectronico) { return manejadorUsuarios.existeCorreo(correoElectronico); }

    // ALTA USUARIO
    @Override
    public boolean altaAsistente(DtAsistente dt) {
        return altaAsistente(dt, null);
    }

    @Override
    public boolean altaAsistente(DtAsistente dt, DtImagen imagen) {
        if (imagen != null) validarImagen(imagen);
        if (dt == null) {
            throw new IllegalArgumentException("Los datos del asistente son obligatorios.");
        }

        validarDatosUsuario(dt.getNickname(), dt.getNombre(), dt.getCorreoElectronico());
        validarContrasenia(dt.getContrasenia(), dt.getConfirmacionContrasenia());
        validarObligatorio(dt.getApellido(), "El apellido es obligatorio.");
        validarNacimiento(dt.getFechaNacimiento());
        Institucion institucion = null;

        if (dt.getNombreInstitucion() != null && !dt.getNombreInstitucion().isBlank()) {
            institucion = manejadorInstituciones.obtenerInstitucion(dt.getNombreInstitucion());

            if (institucion == null) {
                throw new IllegalArgumentException("La institución seleccionada no existe.");
            }
        }

        Asistente asistente = new Asistente(
                dt.getNickname(),
                dt.getNombre(),
                dt.getCorreoElectronico(),
                dt.getApellido(),
                dt.getFechaNacimiento(),
                institucion
        );
        asistente.setContrasenia(dt.getContrasenia());
        // La cascada guarda usuario e imagen en la misma transacción del manejador.
        if (imagen != null) {
            asistente.setImagen(new Imagen(
                    imagen.getTipoContenido().toLowerCase(Locale.ROOT), imagen.getContenido()));
        }
        return manejadorUsuarios.addUsuario(asistente);
    }

    @Override
    public boolean altaOrganizador(DtOrganizador dt) {
        return altaOrganizador(dt, null);
    }

    @Override
    public boolean altaOrganizador(DtOrganizador dt, DtImagen imagen) {
        if (imagen != null) validarImagen(imagen);
        if (dt == null) {
            throw new IllegalArgumentException("Los datos del organizador son obligatorios.");
        }

        validarDatosUsuario(dt.getNickname(), dt.getNombre(), dt.getCorreoElectronico());
        validarContrasenia(dt.getContrasenia(), dt.getConfirmacionContrasenia());

        validarObligatorio(dt.getDescripcion(), "La descripción es obligatoria.");
        validarTexto("sitio web", dt.getSitioWeb());

        Organizador organizador = new Organizador(
                dt.getNickname(),
                dt.getNombre(),
                dt.getCorreoElectronico(),
                dt.getDescripcion(),
                dt.getSitioWeb()
        );
        organizador.setContrasenia(dt.getContrasenia());
        // La cascada guarda usuario e imagen en la misma transacción del manejador.
        if (imagen != null) {
            organizador.setImagen(new Imagen(
                    imagen.getTipoContenido().toLowerCase(Locale.ROOT), imagen.getContenido()));
        }
        return manejadorUsuarios.addUsuario(organizador);
    }

    // CONSULTA USUARIO
    @Override
    public Collection<DtUsuario> listarUsuarios() {
        Collection<DtUsuario> resultado = new ArrayList<>();

        for (Usuario usuario : manejadorUsuarios.listarUsuarios()) {
            if (usuario instanceof Asistente asistente) {
                resultado.add(new DtAsistente(
                        asistente.getNickname(),
                        asistente.getNombre(),
                        asistente.getCorreoElectronico(),
                        asistente.getApellido(),
                        asistente.getFechaNacimiento(),
                        asistente.getNombreInstitucion(),
                        asistente.getFechaAlta()
                ));

            } else if (usuario instanceof Organizador organizador) {
                resultado.add(new DtOrganizador(
                        organizador.getNickname(),
                        organizador.getNombre(),
                        organizador.getCorreoElectronico(),
                        organizador.getDescripcion(),
                        organizador.getSitioWeb(),
                        organizador.getFechaAlta()
                ));
            }
        }
        return resultado;
    }

    @Override
    public DtUsuario consultarUsuario(String nickname) {
        Usuario usuario = manejadorUsuarios.obtenerUsuario(nickname);
        if (usuario == null) { return null; }
        if (usuario instanceof Asistente asistente) {
            return new DtAsistente(
                    asistente.getNickname(),
                    asistente.getNombre(),
                    asistente.getCorreoElectronico(),
                    asistente.getApellido(),
                    asistente.getFechaNacimiento(),
                    asistente.getNombreInstitucion(),
                    asistente.getFechaAlta()
            );
        }
        if (usuario instanceof Organizador organizador) {
            return new DtOrganizador(
                    organizador.getNickname(),
                    organizador.getNombre(),
                    organizador.getCorreoElectronico(),
                    organizador.getDescripcion(),
                    organizador.getSitioWeb(),
                    organizador.getFechaAlta()
            );
        }
        return null;
    }

    @Override
    public Collection<DtRegistro> obtenerRegistrosAsistente(String nickname) {
        Collection<DtRegistro> resultado = new ArrayList<>();

        for (Registro registro : manejadorRegistros.obtenerRegistrosAsistente(nickname)) {
            resultado.add(aDtRegistro(registro));
        }
        return resultado;
    }

    // Arma el DtRegistro de las consultas: con el asistente y si usó código de patrocinio
    // (el código en sí no se publica).
    private DtRegistro aDtRegistro(Registro registro) {
        String nombreTipoRegistro = null;
        String nombreEdicion = null;
        String nicknameAsistente = null;

        if (registro.getTipoRegistro() != null) {
            nombreTipoRegistro = registro.getTipoRegistro().getIdNombre();
        }

        if (registro.getEdicion() != null) {
            nombreEdicion = registro.getEdicion().getIdNombre();
        }

        if (registro.getAsistente() != null) {
            nicknameAsistente = registro.getAsistente().getNickname();
        }

        DtRegistro dt = new DtRegistro(
                registro.getFechaRegistro(),
                registro.getCosto(),
                nombreTipoRegistro,
                nombreEdicion,
                nicknameAsistente,
                registro.getPatrocinio() != null
        );
        dt.setAsistenciaConfirmada(registro.isAsistenciaConfirmada());
        return dt;
    }

    private void autorizarTitular(Actor actor, String nickname) {
        if (actor == null || (!actor.esAdministradorLocal()
                && (actor.nickname() == null || actor.nickname().isBlank()
                || !actor.nickname().equals(nickname)))) {
            throw new excepciones.AccesoDenegadoException("Solo puede modificar su propio perfil o actuar como administrador local.");
        }
    }

    private void autorizarModificacionPerfil(Actor actor, String nickname, boolean organizador) {
        autorizarTitular(actor, nickname);
        if (!actor.esAdministradorLocal() && actor.esOrganizador() != organizador) {
            throw new excepciones.AccesoDenegadoException("El tipo de perfil no corresponde al actor autenticado.");
        }
    }

    @Override
    public void modificarAsistente(DtAsistente dt, Actor actor) {
        modificarAsistente(dt, null, actor);
    }

    @Override
    public void modificarAsistente(DtAsistente dt, DtImagen imagen, Actor actor) {
        autorizarModificacionPerfil(actor, dt == null ? null : dt.getNickname(), false);
        if (imagen != null) validarImagen(imagen);
        if (dt == null || dt.getNickname() == null || !existeUsuario(dt.getNickname())) {
            throw new IllegalArgumentException("El usuario no existe.");
        }
        if (dt.getNombre() == null || dt.getNombre().isBlank()) {
            throw new IllegalArgumentException("El nombre es obligatorio.");
        }
        if (dt.getApellido() == null || dt.getApellido().isBlank()) {
            throw new IllegalArgumentException("El apellido es obligatorio.");
        }
        validarNacimiento(dt.getFechaNacimiento());
        validarTexto("nombre", dt.getNombre());
        validarTexto("apellido", dt.getApellido());

        Institucion institucion = null;
        if (dt.getNombreInstitucion() != null && !dt.getNombreInstitucion().isBlank()) {
            institucion = manejadorInstituciones.obtenerInstitucion(dt.getNombreInstitucion());

            if (institucion == null) {
                throw new IllegalArgumentException("La institución indicada no existe.");
            }
        }

        if (dt.getContrasenia() != null && !dt.getContrasenia().isEmpty()) {
            validarContrasenia(dt.getContrasenia(), dt.getConfirmacionContrasenia());
        }

        if (!manejadorUsuarios.modificarAsistente(
                dt.getNickname(),
                dt.getNombre(),
                dt.getApellido(),
                dt.getFechaNacimiento(),
                institucion,
                dt.getContrasenia(),
                imagen == null ? null : new Imagen(
                        imagen.getTipoContenido().toLowerCase(Locale.ROOT), imagen.getContenido())
        )) {
            throw new IllegalArgumentException("El usuario no existe.");
        }
    }

    @Override
    public void modificarOrganizador(DtOrganizador dt, Actor actor) {
        modificarOrganizador(dt, null, actor);
    }

    @Override
    public void modificarOrganizador(DtOrganizador dt, DtImagen imagen, Actor actor) {
        autorizarModificacionPerfil(actor, dt == null ? null : dt.getNickname(), true);
        if (imagen != null) validarImagen(imagen);
        if (dt == null || dt.getNickname() == null || !existeUsuario(dt.getNickname())) {
            throw new IllegalArgumentException("El usuario no existe.");
        }
        if (dt.getNombre() == null || dt.getNombre().isBlank()) {
            throw new IllegalArgumentException("El nombre es obligatorio.");
        }
        if (dt.getDescripcion() == null || dt.getDescripcion().isBlank()) {
            throw new IllegalArgumentException("La descripción es obligatoria.");
        }

        validarTexto("nombre", dt.getNombre());
        validarTexto("descripción", dt.getDescripcion());
        validarTexto("sitio web", dt.getSitioWeb());

        if (dt.getContrasenia() != null && !dt.getContrasenia().isEmpty()) {
            validarContrasenia(dt.getContrasenia(), dt.getConfirmacionContrasenia());
        }

        if (!manejadorUsuarios.modificarOrganizador(
                dt.getNickname(),
                dt.getNombre(),
                dt.getDescripcion(),
                dt.getSitioWeb(),
                dt.getContrasenia(),
                imagen == null ? null : new Imagen(
                        imagen.getTipoContenido().toLowerCase(Locale.ROOT), imagen.getContenido())
        )) {
            throw new IllegalArgumentException("El usuario no existe.");
        }
    }

    // INSTITUCIONES
    @Override
    public boolean altaInstitucion(DtInstitucion dt, Actor actor) {
        return altaInstitucion(dt, null, actor);
    }

    @Override
    public boolean altaInstitucion(DtInstitucion dt, DtImagen imagen, Actor actor) {
        requerirActorPatrocinio(actor);
        if (imagen != null) validarImagen(imagen);
        if (dt == null) {
            throw new IllegalArgumentException("Los datos de la institución son obligatorios.");
        }
        validarObligatorio(dt.getNombre(), "El nombre de la institución es obligatorio.");
        validarObligatorio(dt.getDescripcion(), "La descripción es obligatoria.");
        validarTexto("sitio web", dt.getSitioWeb());
        if (dt.getSitioWeb() != null && !dt.getSitioWeb().isBlank()
                && !dt.getSitioWeb().matches("(?i)^https?://[^\\s.]+\\.[^\\s]+$")) {
            throw new IllegalArgumentException("Ingresá una URL válida para la institución.");
        }
        Institucion institucion = new Institucion(
                dt.getNombre(),
                dt.getDescripcion(),
                dt.getSitioWeb()
        );
        if (imagen != null) institucion.setImagen(new Imagen(
                imagen.getTipoContenido().toLowerCase(Locale.ROOT), imagen.getContenido()));
        return manejadorInstituciones.addInstitucion(institucion);
    }

    @Override
    public boolean existeInstitucion(String nombre) { return manejadorInstituciones.existeInstitucion(nombre); }

    @Override
    public Collection<DtInstitucion> listarInstituciones() {
        Collection<DtInstitucion> resultado = new ArrayList<>();
        for (Institucion institucion : manejadorInstituciones.listarInstituciones()) {
            resultado.add(new DtInstitucion(
                    institucion.getNombre(),
                    institucion.getDescripcion(),
                    institucion.getSitioWeb()
            ));
        }
        return resultado;
    }

    private void requerirAdministrador(Actor actor) {
        if (actor == null || !actor.esAdministradorLocal())
            throw new excepciones.AccesoDenegadoException("Esta operación requiere un administrador local.");
    }

    // CATEGORÍAS
    @Override
    public void altaCategoria(String nombre, String nombrePadre, Actor actor) throws Exception {
        requerirAdministrador(actor);
        validarTexto("nombre de categoría", nombre);
        if (nombre == null || nombre.trim().isEmpty()) {
            throw new Exception("El nombre de la categoría no puede estar vacío.");
        }
        if (manejadorEventos.obtenerCategoria(nombre) != null) {
            throw new Exception("Ya existe una categoría con el nombre '" + nombre + "'.");
        }

        Categoria categoriaPadre = null;
        if (nombrePadre != null && !nombrePadre.trim().isEmpty()) {
            categoriaPadre = manejadorEventos.obtenerCategoria(nombrePadre);
            if (categoriaPadre == null) {
                throw new Exception("La categoría padre especificada no existe.");
            }
        }
        Categoria nuevaCategoria = new Categoria(nombre, categoriaPadre);
        manejadorEventos.addCategoria(nuevaCategoria);
    }

    @Override
    public Collection<String> listarCategoriasFormateadas() {
        List<String> resultado = new ArrayList<>();

        for (Categoria categoria : manejadorEventos.obtenerCategorias()) {
            if (categoria.getPadre() == null) {
                agregarConIndentacion(categoria, "", resultado);
            }
        }
        return resultado;
    }

    @Override
    public Collection<DtCategoria> listarCategorias() {
        Collection<DtCategoria> resultado = new ArrayList<>();

        for (Categoria categoria : manejadorEventos.obtenerCategorias()) {
            String nombrePadre = null;

            if (categoria.getPadre() != null) {
                nombrePadre = categoria.getPadre().getNombre();
            }

            resultado.add(new DtCategoria(
                    categoria.getNombre(),
                    nombrePadre
            ));
        }

        return resultado;
    }

    private void agregarConIndentacion(Categoria categoria, String prefijo, List<String> resultado) {
        resultado.add(prefijo + categoria.getNombre());
        for (Categoria hija : categoria.getSubcategorias()) {
            agregarConIndentacion(hija, prefijo + "   - ", resultado);
        }
    }

