                panel.mostrar(new DtImagen(mime[i],imagenes[i]));
                if(vista.getIcon()==null)throw new AssertionError("Vista previa no disponible: "+mime[i]+" caso "+i);
            }
            panel.mostrar(new DtImagen("image/png",new byte[]{(byte)137,80,78,71}));
