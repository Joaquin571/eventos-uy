    @Override
    public boolean altaEdicion(DtEdicion dt, String nombreEvento, DtImagen imagen, Actor actor) {
        requerirActorPatrocinio(actor);
        if (dt != null && !actor.esAdministradorLocal() && !actor.nickname().equals(dt.getNombreOrganizador()))
            throw new excepciones.AccesoDenegadoException("No puede crear una edición para otro organizador.");
        if (imagen != null) validarImagen(imagen);
        if (dt == null || dt.getIdNombre() == null || dt.getIdNombre().isBlank()) {
            throw new IllegalArgumentException("El nombre de la edición es obligatorio.");
        }

        validarTexto("nombre de edición", dt.getIdNombre());

        validarObligatorio(nombreEvento, "Debe seleccionar un evento.");
        validarObligatorio(dt.getSigla(), "La sigla es obligatoria.");
        validarObligatorio(dt.getCiudad(), "La ciudad es obligatoria.");
        validarObligatorio(dt.getPais(), "El país es obligatorio.");
        validarObligatorio(dt.getNombreOrganizador(), "El organizador indicado no existe.");

        Evento evento = manejadorEventos.obtenerEvento(nombreEvento);

        if (evento == null) {
            throw new IllegalArgumentException("El evento indicado no existe.");
        }

        if (manejadorEventos.existeEdicion(dt.getIdNombre())) {
            throw new IllegalArgumentException("Ya existe una edición con ese nombre.");
        }

        Organizador organizador = manejadorUsuarios.obtenerOrganizador(dt.getNombreOrganizador());
        if (organizador == null) {
            throw new IllegalArgumentException("El organizador indicado no existe.");
        }

        if (dt.getFechaInicio() == null || dt.getFechaFin() == null) {
            throw new IllegalArgumentException("Las fechas de inicio y de fin son obligatorias.");
        }

        if (dt.getFechaFin().isBefore(dt.getFechaInicio())) {
            throw new IllegalArgumentException("La fecha de fin no puede ser anterior a la de inicio.");
        }

        Edicion edicion = new Edicion(
                dt.getIdNombre(),
                dt.getSigla(),
                dt.getFechaInicio(),
                dt.getFechaFin(),
                LocalDate.now(),
                dt.getCiudad(),
                dt.getPais(),
                organizador
        );
        edicion.setEvento(evento);
        if (imagen != null) edicion.setImagen(new Imagen(imagen.getTipoContenido().toLowerCase(Locale.ROOT), imagen.getContenido()));

        if (!manejadorEventos.addEdicion(edicion)) {
            throw new IllegalArgumentException("Ya existe una edición con ese nombre.");
        }
        return true;
    }

    private DtEdicion aDt(Edicion edicion) {
        String nombreOrganizador = null;
        if (edicion.getOrganizador() != null) {
            nombreOrganizador = edicion.getOrganizador().getNickname();
        }

        DtEdicion dt = new DtEdicion(
                edicion.getIdNombre(),
                edicion.getSigla(),
                edicion.getFechaInicio(),
                edicion.getFechaFin(),
                edicion.getFechaAlta(),
                edicion.getCiudad(),
                edicion.getPais(),
                nombreOrganizador
        );
        dt.setEstado(edicion.getEstado());
        dt.setFechaArchivo(edicion.getFechaArchivo());
        return dt;
    }

