@startuml 04-dss-eventos-ediciones
hide footbox
autonumber
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor white
title DSS - evento, edición y decisión administrativa

actor Organizador as O
actor "Administrador (Swing)" as A
actor "Visitante/asistente" as V
participant "eventos.uy\n(caja negra)" as S
O -> S : POST /alta-evento\ndatos, categorías existentes, imagen opcional
S --> O : Evento creado o formulario con error
O -> S : POST /alta-edicion\nevento, nombre, fechas y datos, imagen opcional
S --> O : Edición propia creada en INGRESADA\no validación con datos conservados
A -> S : Seleccionar evento en Aceptar/Rechazar
S --> A : Ediciones INGRESADA de ese evento
A -> S : Confirmar aceptar o rechazar una edición
alt Edición todavía INGRESADA
 S --> A : Estado ACEPTADA o RECHAZADA confirmado
else Otra decisión ya confirmada
 S --> A : Error de transición; no sobrescribe decisión
end
V -> S : GET /evento?nombre=...
S --> V : Datos y ediciones ACEPTADA
O -> S : GET /usuario?nick=suPropioNick
S --> O : Sus ediciones en los tres estados

@enduml
