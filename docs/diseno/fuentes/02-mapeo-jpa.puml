@startuml 02-mapeo-jpa
!pragma layout smetana
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor white
title Vista de implementación JPA - atributos técnicos y opcionalidad física

hide methods
abstract class Usuario <<JOINED>> {
 nickname : String <<Id>>
 nombre : String
 fechaAlta : LocalDate [updatable=false]
 correoElectronico : String [NOT NULL, UNIQUE]
 contraseniaHash : String
}
class Asistente {
 apellido : String
 fechaNacimiento : LocalDate
}
class Organizador {
 descripcion : String
 sitioWeb : String
}
class Evento {
 nombre : String <<Id>>
 sigla : String
 descripcion : String
 fechaAlta : LocalDate
}
class Edicion {
 idNombre : String <<Id>>
 sigla : String
 ciudad : String
 pais : String
 fechaInicio : LocalDate
 fechaFin : LocalDate
 fechaAlta : LocalDate
 estado : EstadoEdicion [STRING]
}
class TipoRegistro {
 id : Long <<IDENTITY>>
 idNombre : String [NOT NULL]
 descripcion : String
 costo : float
 cupo : int
}
class Registro {
 id : Long <<IDENTITY>>
 fechaRegistro : LocalDate
 costo : float
}
class Patrocinio {
 codigoPatrocinio : String <<Id>>
 fecha : LocalDate
 montoAporte : float
 cantRegistrosGrat : int
 nivel : NivelPatrocinio [STRING]
}
class Institucion {
 nombre : String <<Id>>
 descripcion : String
 sitioWeb : String
}
class Categoria {
 nombre : String <<Id>>
}
class Imagen {
 id : Long <<IDENTITY>>
 tipoContenido : String [NOT NULL]
 contenido : byte[] [NOT NULL]
}
Usuario <|-- Asistente
Usuario <|-- Organizador
Institucion "0..1" -- "0..*" Asistente
Organizador "0..1" -- "0..*" Edicion
Evento "0..1" -- "0..*" Edicion
Evento "0..*" -- "0..*" Categoria : evento_categoria
Categoria "0..1 padre" -- "0..* subcategorias" Categoria
Edicion "1" -- "0..*" TipoRegistro : EDICION_ID NOT NULL
Asistente "0..1" -- "0..*" Registro
Edicion "0..1" -- "0..*" Registro
TipoRegistro "0..1" -- "0..*" Registro
Institucion "0..1" -- "0..*" Patrocinio
Edicion "0..1" -- "0..*" Patrocinio
TipoRegistro "0..1" -- "0..*" Patrocinio
Patrocinio "0..1" -- "0..*" Registro
Usuario "0..1" -- "0..1" Imagen : LAZY, ALL, orphanRemoval
Evento "0..1" -- "0..1" Imagen : LAZY, ALL, orphanRemoval
Edicion "0..1" -- "0..1" Imagen : LAZY, ALL, orphanRemoval
Institucion "0..1" -- "0..1" Imagen : LAZY, ALL, orphanRemoval
legend bottom
 11 entidades, 12 tablas (incluye evento_categoria).
 Colecciones se representan por asociaciones; no son atributos omitidos.
 ManyToOne sin nullable=false admite NULL en el mapeo.
 H13 agrega índices funcionales; no los genera Hibernate automáticamente.
 Estados: INGRESADA, ACEPTADA, RECHAZADA.
 Niveles: PLATINO, ORO, PLATA, BRONCE.
endlegend

@enduml
