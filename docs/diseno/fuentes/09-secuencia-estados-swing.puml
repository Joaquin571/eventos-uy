@startuml 09-secuencia-estados-swing
hide footbox
autonumber
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor white
title Realización - aceptar o rechazar con bloqueo pesimista

actor Administrador as A
participant AceptarRechazarEdicionPanel as P
participant "sistema : ISistema\nSistema" as S
participant ManejadorEventos as M
participant EntityManager as EM
participant EntityTransaction as T
participant Edicion as E
database PostgreSQL as DB
A -> P : Seleccionar evento
P -> S : obtenerEdicionesEvento(evento, INGRESADA)
S --> P : DtEdicion de las ingresadas
A -> P : Confirmar aceptar o rechazar
P -> S : aceptarRechazarEdicion(nombre, aceptar)
S -> M : cambiarEstadoEdicion(nombre, aceptar)
note over M,EM : EM obtenido por BaseDeDatos.getEntityManager()
M -> EM : getTransaction()
M -> T : begin()
M -> EM : find(Edicion.class, nombre, PESSIMISTIC_WRITE)
EM -> DB : SELECT y bloqueo exclusivo de la edición
DB --> EM : Fila bloqueada, después de esperar si hay otra decisión
EM --> M : Edicion gestionada
M -> E : aceptar() o rechazar()
alt Estado INGRESADA
 E -> E : Cambiar a ACEPTADA o RECHAZADA
 M -> T : commit()
 T -> DB : UPDATE confirmado
 M --> S : true
 S --> P : void
 P --> A : Resultado y recarga
else Estado ya decidido
 E --> M : IllegalStateException
 M -> T : rollback() si activa
 M --> P : Excepción a través de Sistema
 P --> A : JOptionPane con mensaje, sin sobrescribir decisión
end
M -> EM : close() en finally
note over S,DB : Web observa el commit con su propia copia de lógica y otro EntityManager.

@enduml
