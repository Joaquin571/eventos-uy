@startuml 10-secuencia-registro
hide footbox
autonumber
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor white
title Realización - registro general o patrocinado y concurrencia

actor Asistente as A
participant RegistroEdicionServlet as C
participant "sistema : ISistema\nSistema" as S
participant ManejadorEventos as E
participant ManejadorRegistros as M
participant "EntityManager / EntityTransaction" as J
database PostgreSQL as DB
A -> C : POST /registro-edicion con token
note over C : FiltroAcceso verifica CSRF/rol; asistente de sesión; no se acepta costo del cliente.
C -> S : registroAEdicion(nick, edición, tipo, dt, código o null)
S -> E : obtenerEdicion(nombreEdicion)
E --> S : Edición
S -> S : Exigir ACEPTADA; LocalDate.now()
S -> M : registrar(nick, edición, tipo, fechaActual, código)
M -> J : tx.begin(); find(Asistente, nick, PESSIMISTIC_WRITE)
J -> DB : SELECT y bloqueo de asistente
M -> J : find(Edicion); query del tipo; lock(tipo, PESSIMISTIC_WRITE)
J -> DB : SELECT y bloqueo de tipo
M -> J : Consultar registro previo
opt Código informado
 M -> J : find(Patrocinio, código, PESSIMISTIC_WRITE)
 J -> DB : SELECT y bloqueo del patrocinio
 M -> M : Verificar institución, edición y tipo; contar usos
end
M -> J : Recontar duplicados y ocupación del tipo
J -> DB : COUNT de registros en la misma transacción
alt Datos válidos, cupo y usos disponibles
 M -> M : new Registro(fechaActual, costoTipo o 0, tipo, edición)\nsetAsistente; setPatrocinio cuando corresponde
 M -> J : persist(registro); tx.commit()
 J -> DB : INSERT; unicidad asistente/edición
 M --> S : true
 S --> C : true
 C --> A : 302 /consulta-registro?... (PRG)
else Inexistente, duplicado, sin cupo o código no aplicable
 M -> J : tx.rollback() si activa
 M --> C : Excepción de negocio a través de Sistema
 C --> A : Formulario y selección conservados
end
M -> J : em.close() en finally
note over M,DB : No existe contador de usos consumido en otra transacción: se cuentan registros asociados al patrocinio.

@enduml
